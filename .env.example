# ─────────────────────────────────────────────────────────────
# Diş Kliniği — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# Secret değerleri asla repository'ye eklemeyin; istemciye aktarılmazlar
# (NEXT_PUBLIC_ önekli değişken kullanılmamaktadır).
# ─────────────────────────────────────────────────────────────

# PostgreSQL bağlantısı
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dis_klinigi"
# Entegrasyon testleri için ayrı veritabanı (testler bu DB'yi sıfırlar!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dis_klinigi_test"

# Uygulamanın dışarıdan erişilen adresi (OAuth yönlendirmeleri ve e-posta linkleri için)
APP_URL="http://localhost:3000"

# Public sitede gösterilecek kliniğin slug değeri (çoklu klinik için alan adı eşlemesi yapılabilir)
PUBLIC_CLINIC_SLUG="demo-klinik"

# Google token'larını şifrelemek için 32 baytlık anahtar (base64).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# IP adreslerini hash'lemek (rate limit / audit) için gizli tuz
IP_HASH_SALT=""

# /api/cron/outbox uç noktasını korumak için gizli anahtar (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ───────────── E-posta ─────────────
# console | smtp | resend   (console: gerçek gönderim yapmaz, sunucu konsoluna yazar)
EMAIL_PROVIDER="console"
EMAIL_FROM="Demo Diş Kliniği <no-reply@example.com>"
# Yeni randevu taleplerinin bildirileceği admin adresi (klinik ayarında yoksa kullanılır)
ADMIN_NOTIFICATION_EMAIL="serhatkenar39@gmail.com"

# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Resend (EMAIL_PROVIDER=resend) — gönderen alan adı Resend'de doğrulanmış olmalı
RESEND_API_KEY=""

# ───────────── SMS ─────────────
# console | netgsm   (console: gerçek SMS göndermez)
SMS_PROVIDER="console"
# Gerçek SMS gönderimi yalnızca bu değer "true" ise yapılır. Aksi halde SMS_PROVIDER ne olursa olsun mock kullanılır.
SMS_LIVE_SEND="false"
# Geliştirme/test ortamında tüm SMS'ler bu numaraya yönlendirilir (production'da yok sayılır)
SMS_TEST_RECIPIENT="5455015611"

# NetGSM (SMS_PROVIDER=netgsm) — onaylı gönderici başlığı (msgheader) gerekir
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_MSGHEADER=""

# ───────────── Google Calendar (OAuth 2.0) ─────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Yetkili yönlendirme URI'si: {APP_URL}/api/google/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# ───────────── Seed ─────────────
# Demo şifresi (yalnızca geliştirme). Production'da seed çalışmaz.
SEED_DEMO_PASSWORD="Demo1234!"

# ───────────── WhatsApp (Meta Cloud API) ─────────────
# Mesaj ücreti kliniğin kendi Meta hesabından kesilir; klinik bağlantısı (telefon numarası kimliği, token, şablon)
# panelden Entegrasyonlar sayfasında girilir ve şifreli saklanır.
# Gerçek WhatsApp gönderimi yalnızca bu değer "true" ise yapılır. Aksi halde mock (konsol) kullanılır.
WHATSAPP_LIVE_SEND=
# Meta uygulamasının "App Secret" değeri (webhook imzasını doğrulamak için)
WHATSAPP_APP_SECRET=
# Webhook doğrulamasında Meta'ya girdiğiniz "Verify token" (kendiniz belirlediğiniz rastgele bir metin)
WHATSAPP_VERIFY_TOKEN=
# Geliştirmede tüm WhatsApp mesajları bu numaraya yönlendirilir (production'da yok sayılır)
WHATSAPP_TEST_RECIPIENT=
# İsteğe bağlı: Graph API sürümü (varsayılan v21.0)
WHATSAPP_API_VERSION=
